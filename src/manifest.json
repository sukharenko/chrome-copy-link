{
  "manifest_version": 3,
  "name": "Copy Link",
  "short_name": "Copy Link",
  "version": "1.0.0",
  "description": "One click copies the current tab's URL to the clipboard. Nothing else.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Copy link",
    "default_icon": {
      "16": "icons/light-16.png",
      "32": "icons/light-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "clipboardWrite", "offscreen"],
  "minimum_chrome_version": "116"
}
